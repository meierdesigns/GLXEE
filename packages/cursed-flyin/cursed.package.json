      "label": "CursedFlyin CSS"
    }
  ],
  "links": [],
  "embed": {
    "script": "assets/js/cursed-flyin.js",
    "css": "assets/css/cursed-flyin.css",
    "global": "CursedFlyin",
    "example": "CursedFlyin.autoMount({ baseUrl: 'http://127.0.0.1:6190', targetProject: '/path/to/project' });"
  }
