{
  "name": "glxee",
  "version": "1.14.9",
  "description": "GLXEE \u2014 Game Boy\u2013shell space shooter. Five doctrines. Living galaxies. Next jump.",
  "main": "index.html",
  "scripts": {
    "start": "python3 tools/dev-server.py ${PORT:-3000}",
    "dev": "python3 tools/dev-server.py ${PORT:-3000}",
    "serve": "python3 tools/dev-server.py ${PORT:-3000}",
    "build:bundle": "python3 tools/build-deferred-bundle.py --update-index",
    "ship:audit": "python3 tools/ship-audit.py",
    "comfy": "bash tools/comfyui/start.sh",
    "comfy:stop": "bash tools/comfyui/stop.sh",
    "asset-gen": "bash tools/asset-gen/start.sh",
    "assets": "bash tools/asset-gen/start-all.sh",
    "icons:preview": "python3 tools/render-icon-sprites.py",
    "icons:preview:menu": "python3 tools/render-icon-sprites.py menuAssets menuSettings menuCredits menuProfiles --scale 16 --tint FF6A00"
  },
  "keywords": [
    "game",
    "space-shooter",
    "gameboy",
    "retro",
    "javascript"
  ],
  "author": "meierdesigns <https://github.com/meierdesigns>",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
