  "tags": ["scripts", "styles", "ui", "ai", "core"],
  "files": [
    "assets/js/cursed-element-inspect.js",
    "assets/js/cursed-flyin.js",
    "assets/css/cursed-flyin.css"
  ],
  "dependencies": ["cursed-bridge"],
  "sourceProject": "/mnt/quicky2/Cursor/Cursed",
  "source": "core",
  "exports": [
    {
      "id": "cursed-flyin",
